pre_remove() {
  # Retira únicamente las reglas persistentes que Antena creó.
  # Nunca elimina controladores de terceros: eso exige consentimiento explícito.
  if [ -x /usr/lib/antena/antena-helper ]; then
    printf '%s\n' '{"remove_driver": false}' | /usr/lib/antena/antena-helper cleanup >/dev/null 2>&1 || true
  fi
}

post_remove() {
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_install() {
  update-desktop-database -q /usr/share/applications 2>/dev/null || true
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
}

post_upgrade() {
  post_install
}
