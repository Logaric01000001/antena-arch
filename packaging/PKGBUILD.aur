# Maintainer: Antena contributors <antena@example.invalid>
# PLANTILLA para AUR. No se ha publicado nada.
# Antes de enviarlo:
#   1. Publica el repositorio y crea el tag v0.1.0.
#   2. Sustituye USUARIO por el propietario real.
#   3. Calcula sha256 del tarball del tag y sustituye SKIP.
#   4. Verifica con `makepkg -f` y `namcap`.
pkgname=antena-arch
pkgver=0.1.0
pkgrel=1
pkgdesc="Asistente gráfico para configurar adaptadores Wi-Fi USB en Arch Linux"
arch=('any')
url="https://github.com/USUARIO/antena-arch"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'networkmanager' 'polkit' 'usb_modeswitch' 'dkms' 'iw' 'pacman')
optdepends=(
  'linux-headers: compilar controladores DKMS para el kernel en ejecución'
  'tcpdump: prueba pasiva de recepción en modo monitor'
)
install=antena-arch.install
options=(!strip)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/usr/lib/antena"
  cp -a antena "$pkgdir/usr/lib/antena/antena"
  find "$pkgdir/usr/lib/antena/antena" -type d -name '__pycache__' -prune -exec rm -rf {} +
  find "$pkgdir/usr/lib/antena/antena" -type f -name '*.pyc' -delete
  rm -rf "$pkgdir/usr/lib/antena/antena/bin"
  install -Dm755 bin/antena "$pkgdir/usr/bin/antena"
  install -Dm755 bin/antena-helper "$pkgdir/usr/lib/antena/antena-helper"
  install -Dm755 antena/bin/antena-modeswitch-aic8800d80 "$pkgdir/usr/lib/antena/bin/antena-modeswitch-aic8800d80"
  install -d "$pkgdir/usr/share/antena/catalog"
  install -m644 antena/catalog/*.json "$pkgdir/usr/share/antena/catalog/"
  install -Dm644 antena/data/icons/hicolor/scalable/apps/io.github.antena.Antena.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.antena.Antena.svg"
  install -Dm644 antena/data/icons/hicolor/symbolic/apps/io.github.antena.Antena-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.antena.Antena-symbolic.svg"
  install -Dm644 packaging/io.github.antena.Antena.desktop "$pkgdir/usr/share/applications/io.github.antena.Antena.desktop"
  install -Dm644 packaging/io.github.antena.Antena.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.antena.Antena.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
